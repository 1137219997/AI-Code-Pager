#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/*
 * Default GPIO map for a generic nRF52840 ProMicro-compatible module.
 * Clones expose different silk-screen names; change only this file when
 * adapting the firmware to a particular PCB revision.
 */

/ {
    chosen {
        zephyr,display = &lcd0;
    };

    aliases {
        input0 = &key0;
        input1 = &key1;
        input2 = &key2;
        input3 = &key3;
        input4 = &key4;
        input5 = &key5;
        nav-up = &nav_up;
        nav-down = &nav_down;
        nav-left = &nav_left;
        nav-right = &nav_right;
        nav-push = &nav_push;
        encoder-a = &encoder_a;
        encoder-b = &encoder_b;
        backlight = &backlight_led;
    };

    keys {
        compatible = "gpio-keys";
        key0: key_0 { gpios = <&gpio0 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        key1: key_1 { gpios = <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        key2: key_2 { gpios = <&gpio0 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        key3: key_3 { gpios = <&gpio0 5 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        key4: key_4 { gpios = <&gpio0 28 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        key5: key_5 { gpios = <&gpio0 29 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        nav_up: nav_up { gpios = <&gpio0 30 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        nav_down: nav_down { gpios = <&gpio0 31 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        nav_left: nav_left { gpios = <&gpio1 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        nav_right: nav_right { gpios = <&gpio1 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        nav_push: nav_push { gpios = <&gpio1 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        encoder_a: encoder_a { gpios = <&gpio1 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
        encoder_b: encoder_b { gpios = <&gpio1 7 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; };
    };

    backlight: backlight_control {
        compatible = "gpio-leds";
        backlight_led: bl {
            gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
            label = "LCD backlight";
        };
    };
};

&pinctrl {
    spi1_default: spi1_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>;
        };
    };

    spi1_sleep: spi1_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>;
            low-power-enable;
        };
    };
};

&spi1 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;

    lcd0: st7789v@0 {
        compatible = "sitronix,st7789v";
        reg = <0>;
        spi-max-frequency = <32000000>;
        cmd-data-gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&gpio1 0 GPIO_ACTIVE_LOW>;

        width = <320>;
        height = <170>;
        x-offset = <0>;
        y-offset = <35>;

        vcom = <0x19>;
        gctrl = <0x35>;
        vrhs = <0x12>;
        vdvs = <0x20>;
        mdac = <0x60>;
        gamma = <0x01>;
        colmod = <0x05>;
        lcm = <0x2c>;
        porch-param = [0c 0c 00 33 33];
        cmd2en-param = [5a 69 02 01];
        pwctrl1-param = [a4 a1];
        pvgam-param = [d0 04 0d 11 13 2b 3f 54 4c 18 0d 0b 1f 23];
        nvgam-param = [d0 04 0c 11 13 2c 3f 44 51 2f 1f 1f 20 23];
        ram-param = [00 f0];
        rgb-param = [cd 08 14];
    };
};
